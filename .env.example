# Centralized Environment Configuration for LOCAL DEVELOPMENT
# This file is gitignored - never commit sensitive data

# Server Configuration
PORT=5050
API_HOST=localhost
CORS_ORIGIN=http://localhost:5050
VITE_SERVER_URL=http://localhost:5050
BETTER_AUTH_URL=http://localhost:5050

EDITOR_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acmepdf

# Authentication
BETTER_AUTH_SECRET=your_super_secret_better_auth_key

# Environment
NODE_ENV=development

# ── Landing Page Runtime Tokens ────────────────────────────────────────────────
# Used by the API server to replace __TOKEN__ placeholders in the built HTML.
# In production these are set as Docker container env vars (not build-args).
# VITE_GA_MEASUREMENT_ID below is still used by the local Vite dev server.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX
ADSENSE_CLIENT_ID=ca-pub-0000000000000000
ADSENSE_SLOT_LANDING_HERO=0000000000
ADSENSE_SLOT_LANDING_CTA=0000000000
# ──────────────────────────────────────────────────────────────────────────────

STIRLING_PDF_URL=https://api.example.com
STIRLING_PDF_API_KEY=your_stirling_pdf_api_key
