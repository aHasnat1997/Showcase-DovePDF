FROM oven/bun:1.3.9 AS builder
WORKDIR /app

COPY package.json bun.lock turbo.json tsconfig.json ./
COPY apps/landing-page/package.json apps/landing-page/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/env/package.json packages/env/package.json

RUN bun install

COPY apps/landing-page apps/landing-page
COPY packages/config packages/config
COPY packages/env packages/env

RUN cd apps/landing-page && bun install

RUN bunx turbo build --filter=landing-page

FROM nginx:alpine
COPY --from=builder /app/apps/landing-page/dist /usr/share/nginx/html
COPY apps/landing-page/docker/runtime-config.sh /docker-entrypoint.d/99-runtime-config.sh
RUN chmod +x /docker-entrypoint.d/99-runtime-config.sh
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
