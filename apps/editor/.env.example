# Server Configuration
# The URL of the API server (same as packages/api's CORS_ORIGIN)
VITE_SERVER_URL=http://localhost:5050

# API server hostname (used internally)
VITE_API_HOST=localhost

# Uncomment for production subdomain deployment
# VITE_SERVER_URL=https://api.example.com
# VITE_API_HOST=api.example.com

# Google Analytics (GA4)
# Example: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Google AdSense
# Example: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID=
# Example slots: 1234567890
VITE_ADSENSE_SLOT_RIGHT_PANEL=
VITE_ADSENSE_SLOT_PREVIEW_EMPTY=
