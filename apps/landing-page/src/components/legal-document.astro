---
import type { LegalDocumentData } from '../constant/legal-content';

interface Props {
  data: LegalDocumentData;
}

const { data } = Astro.props;
---

<!-- Hero -->
<div class="bg-gradient-to-b from-primary/10 to-white/60 px-4 py-10 text-center sm:px-5 sm:py-14">
  <div class="mx-auto max-w-6xl">
    <span class="inline-flex rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold text-primary! sm:text-[14px]">
      {data.badge}
    </span>
    <h1 class="mt-4 font-jakarta text-3xl font-bold tracking-tight text-balance text-slate-900 sm:text-4xl md:text-5xl">
      {data.title}
    </h1>
    <p class="mt-3 text-sm text-text-muted sm:text-base">
      Last updated: <strong class="text-slate-700">{data.lastUpdated}</strong>
      <span class="hidden sm:inline">&nbsp;·&nbsp;</span>
      <span class="block sm:inline">{data.intro}</span>
    </p>
  </div>
</div>

<div class="mx-auto max-w-6xl px-4 py-10 sm:px-5 sm:py-14">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-10">

    <!-- TOC: collapsible on mobile/tablet, sticky sidebar from lg up -->
    <aside class="shrink-0 lg:sticky lg:top-6 lg:w-64">
      <details class="group rounded-2xl border border-slate-200 bg-slate-50 p-4 sm:p-6" open>
        <summary class="flex cursor-pointer list-none items-center justify-between font-jakarta text-sm font-semibold uppercase tracking-wide text-slate-900 lg:cursor-default">
          Table of Contents
          <svg
            class="size-4 shrink-0 transition-transform group-open:rotate-180 lg:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <ol class="mt-4 space-y-2 text-sm text-text-muted">
          {data.sections.map((section, i) => (
            <li>
              <a href={`#${section.id}`} class="transition hover:text-brand-600" onclick="if(window.innerWidth < 1024) this.closest('details').removeAttribute('open')">
                {i + 1}. {section.tocLabel ?? section.title}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </aside>

    <!-- Content -->
    <div class="min-w-0 flex-1 space-y-8 sm:space-y-10">

      {data.shortVersion && (
        <div class="rounded-2xl border border-primary/20 bg-primary/5 px-4 py-4 text-sm leading-7 break-words text-slate-700 sm:px-6 sm:py-5">
          <strong class="text-slate-900">Short version:</strong> {data.shortVersion}
        </div>
      )}

      {data.sections.map((section, i) => (
        <section id={section.id} class="scroll-mt-20 space-y-3">
          <h2 class="flex items-start gap-3 font-jakarta text-lg font-bold text-balance text-slate-900 sm:items-center sm:text-xl">
            <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary! sm:mt-0 sm:size-8 sm:text-sm">
              {i + 1}
            </span>
            {section.title}
          </h2>

          {section.blocks.map((block) => {
            switch (block.type) {
              case "paragraph":
                return <p class="text-sm leading-7 break-words text-text-muted" set:html={block.text} />;

              case "list":
                return (
                  <>
                    {block.intro && (
                      <p class="text-sm font-semibold break-words text-slate-700" set:html={block.intro} />
                    )}
                    <ul class="list-outside list-disc space-y-2 pl-5 text-sm leading-7 break-words text-text-muted">
                      {block.items.map((item) => (
                        <li set:html={item} />
                      ))}
                    </ul>
                  </>
                );

              case "callout": {
                const styles =
                  block.variant === "warning"
                    ? "border-amber-200 bg-amber-50 text-amber-900"
                    : "border-primary/20 bg-primary/5 text-slate-700";
                return (
                  <div class={`rounded-2xl border px-4 py-4 text-sm leading-7 break-words sm:px-6 sm:py-5 ${styles}`}>
                    {block.title && <strong>{block.title}: </strong>}
                    <span set:html={block.text} />
                  </div>
                );
              }

              case "contact":
                return (
                  <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-4 text-sm leading-7 text-text-muted sm:px-6 sm:py-5">
                    {block.items.map((item) => (
                      <p class="break-words">
                        <strong class="text-slate-700">{item.label}:</strong>{" "}
                        {item.href ? (
                          <a href={item.href} class="text-brand-600 hover:underline">
                            {item.value}
                          </a>
                        ) : (
                          item.value
                        )}
                      </p>
                    ))}
                  </div>
                );

              default:
                return null;
            }
          })}
        </section>
      ))}

    </div>
  </div>
</div>