---
import { tools } from "../constant/landing-content";
---

<section id="popular-tools" class="mx-auto max-w-6xl px-5 py-16 sm:py-24" aria-labelledby="popular-tools-title">
  <div class="text-center reveal">
    <p class="section-badge">Our Tools</p>
    <h2 id="popular-tools-title" class="mt-3 font-jakarta text-[48px] font-bold text-slate-900">Most Popular PDF Tools</h2>
    <p class="mt-3 text-[20px] leading-7 text-text-muted">Everything you need to work with PDFs, all in one place.</p>
  </div>
  <div id="tools-grid" class="mt-12 grid gap-5 md:grid-cols-3">
    {tools.map((tool, index) => (
      <article class="reveal rounded-2xl border border-slate-200 bg-white p-7 shadow-sm flex flex-col" style={`transition-delay:${index * 80}ms`}>
        <div>
          <div class="w-fit rounded-xl bg-primary flex items-center justify-center">
            <img src={tool.icon} alt={tool.title} class="size-[42px] p-2" />
          </div>
          <h3 class="mt-5 font-jakarta text-[24px] font-semibold text-slate-900">{tool.title}</h3>
          <p class="mt-3 text-[16px] leading-7 text-text-muted">{tool.description}</p>
        </div>
        <div class="mt-auto">
          <a href="https://editor.acmepdf.com" data-editor-link class="mt-4 inline-block text-[14px] font-semibold text-brand-600 hover:text-brand-700">{tool.action} →</a>
        </div>
      </article>
    ))}
  </div>
</section>
