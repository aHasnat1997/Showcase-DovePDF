{
  "name": "dove-PDF",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "@types/bun": "^1.3.10",
      "@trpc/server": "^11.13.4",
      "@types/express": "^5.0.6",
      "vitest": "^3.1.1",
      "@vitest/ui": "^3.1.1",
      "@vitest/coverage-v8": "^3.1.1",
      "jsdom": "^26.0.0",
      "@trpc/client": "^11.13.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node api.js && turbo dev",
    "build": "node api.js && turbo build",
    "check-types": "turbo check-types",
    "dev:landing": "turbo -F landing-page dev",
    "dev:editor": "turbo -F editor dev",
    "dev:api": "turbo -F @acme-pdf/api dev",
    "dev:server": "turbo -F @acme-pdf/api dev"
  },
  "dependencies": {
    "@acme-pdf/env": "workspace:*",
