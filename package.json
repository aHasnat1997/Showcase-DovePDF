    "@tiptap/extension-font-family": "^3.22.0",
    "@tiptap/extension-text-style": "^3.22.0",
    "dotenv": "catalog:",
    "pdfjs-dist": "5.4.296",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@acme-pdf/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.6.3",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.9"
